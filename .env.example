# BuildSmartAI Configuration
APP_NAME=BuildSmartAI
ENV=development
PORT=8000
HOST=127.0.0.1
DATABASE_URL=sqlite:///./buildsmart.db

# Ollama LLM Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# File Storage
UPLOAD_DIR=./uploads
GENERATED_DESIGNS_DIR=./generated_designs
GENERATED_REPORTS_DIR=./generated_reports

# Security & Secret Key
SECRET_KEY=dev-secret-key-change-in-production-buildsmart
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
